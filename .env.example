# Keep production in PREPARE mode unless you intentionally change the execution model.
CIRCUIT_EXECUTION_MODE=PREPARE
CELO_RPC_URL=https://forno.celo.org
USAT_TOKEN_ADDRESS=0xD2ab3C9A02DBBAB236BfEC45D1d755DF4267F771
CNGN_TOKEN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f
X402_FACILITATOR_URL=https://api.x402.celo.org

# Local development may use memory. Vercel/Node production forces Supabase
# regardless of this value and fails closed if either credential is missing.
CIRCUIT_ACTIVITY_STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Before production deployment, apply docs/sql/activity-store.sql to the same
# Supabase project referenced by the two variables above. Never expose the
# service-role key to browser code or NEXT_PUBLIC/VITE/public environment vars.

# Optional if you later expose a paid resource through the Celo facilitator:
X402_API_KEY=
X402_PAY_TO=
